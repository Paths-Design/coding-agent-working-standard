#!/bin/bash
# CAWS pre-push hook — repo-local to the caws monorepo.
#
# Mirrors the CI pipeline so a push cannot fail in CI for something reproducible
# locally. Deliberately strict: there is no environment-variable escape hatch.
#
# Note on --no-verify: git passes a pre-push hook <remote-name> <remote-url> and
# nothing else, so the user's flags never appear in "$@"; and git does not run
# this hook at all under --no-verify. A hook can never police its own bypass.
# The real control is review + branch protection.

# git hooks run with a minimal PATH; restore the usual locations.
export PATH="/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin:$PATH"
if [ -s "$HOME/.nvm/nvm.sh" ]; then
  # shellcheck disable=SC1091
  . "$HOME/.nvm/nvm.sh"
elif [ -s "/usr/local/opt/nvm/nvm.sh" ]; then
  # shellcheck disable=SC1091
  . "/usr/local/opt/nvm/nvm.sh"
fi

set -uo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Fail CLOSED if the lock library is missing. A guard that silently proceeds
# without its concurrency control is worse than one that refuses: it is the
# `source <missing> || true` pattern this repo bans outright.
if [ ! -f "$HOOK_DIR/lib/prepush-lock.sh" ]; then
  echo "pre-push: $HOOK_DIR/lib/prepush-lock.sh is missing — refusing." >&2
  echo "  Without it two concurrent pushes would build against the shared turbo cache." >&2
  exit 1
fi
# shellcheck source=lib/prepush-lock.sh
. "$HOOK_DIR/lib/prepush-lock.sh"

# Portable timeout: macOS ships neither GNU timeout nor gtimeout by default.
# Returns the command's own status, or 124 on timeout.
run_with_timeout() {
  local seconds="$1"; shift
  local timeout_cmd=""
  if command -v timeout >/dev/null 2>&1; then
    timeout_cmd="timeout"
  elif command -v gtimeout >/dev/null 2>&1; then
    timeout_cmd="gtimeout"
  fi
  if [ -n "$timeout_cmd" ]; then
    "$timeout_cmd" "$seconds" "$@"
    return $?
  fi
  # No timeout binary available: run unbounded rather than skipping the check.
  "$@"
  return $?
}

[ -f package.json ] && [ -f turbo.json ] || exit 0

# ── Serialise the heavy stages across every worktree of this repository ───
LOCK_DIR=$(caws_prepush_lock_dir) || LOCK_DIR=""
if [ -z "$LOCK_DIR" ]; then
  echo "pre-push: could not resolve the git common dir to place the build lock — refusing." >&2
  exit 1
fi

caws_prepush_lock_acquire "$LOCK_DIR" 1800 5
LOCK_STATUS=$?
if [ "$LOCK_STATUS" -eq 2 ]; then
  echo "pre-push: could not create the build lock at" >&2
  echo "    $LOCK_DIR" >&2
  echo "  and nothing is holding it, so this is not contention — the filesystem" >&2
  echo "  refused the symlink. Refusing rather than running unlocked, which would" >&2
  echo "  let a sibling worktree build against the same turbo cache." >&2
  exit 1
fi
if [ "$LOCK_STATUS" -ne 0 ]; then
  HOLDER=$(caws_prepush_lock_owner "$LOCK_DIR" || echo "unknown")
  echo "pre-push: another pre-push (pid $HOLDER) has been running the build/test" >&2
  echo "  stages in this repository for over 30 minutes. Refusing to start a second" >&2
  echo "  concurrent build — they share node_modules and the turbo cache, so running" >&2
  echo "  both corrupts each other's artifacts." >&2
  echo "  Wait for it to finish and push again, or if that process is gone, remove:" >&2
  echo "    $LOCK_DIR" >&2
  exit 1
fi
# Release on every exit path, including a failed stage or an interrupt.
trap 'caws_prepush_lock_release "$LOCK_DIR"' EXIT INT TERM

FAILED=false

echo "pre-push: mirroring CI (typecheck, lint, audit, build, test)"

# 1. Typecheck. FIRST because it is the cheapest stage by an order of magnitude
# and the one whose absence actually cost us: ts-jest does not gate on
# diagnostics, so a type error in a test file is invisible to stage 5 and
# surfaces only in Release Qualification — which nobody reads until a release is
# attempted. Main accepted red-qualification commits for two days on that gap.
#
# The -w flag is load-bearing, not stylistic. Root .npmrc sets workspaces=true,
# so a bare `npm run typecheck` resolves against the workspaces and never
# reaches the intended script. This is the exact invocation
# .github/workflows/release-qualification.yml runs.
echo "  [1/5] typecheck"
run_with_timeout 600 npm run typecheck -w @paths.design/caws-cli
TYPECHECK_EXIT=$?
if [ $TYPECHECK_EXIT -eq 124 ]; then
  echo "  typecheck timed out after 10m" >&2; FAILED=true
elif [ $TYPECHECK_EXIT -ne 0 ]; then
  echo "  typecheck failed (exit $TYPECHECK_EXIT) — reproduce with: npm run typecheck -w @paths.design/caws-cli" >&2; FAILED=true
fi

# 2. Lint
echo "  [2/5] lint"
run_with_timeout 600 npx turbo run lint
LINT_EXIT=$?
if [ $LINT_EXIT -eq 124 ]; then
  echo "  lint timed out after 10m" >&2; FAILED=true
elif [ $LINT_EXIT -ne 0 ]; then
  echo "  lint failed (exit $LINT_EXIT) — reproduce with: npx turbo run lint" >&2; FAILED=true
fi

# 3. Security audit (critical only; high has unfixable transitive deps)
echo "  [3/5] audit"
if ! npm audit --audit-level=critical; then
  echo "  audit failed — reproduce with: npm audit --audit-level=critical" >&2; FAILED=true
fi

# 4. Build
echo "  [4/5] build"
run_with_timeout 900 npm run build
BUILD_EXIT=$?
if [ $BUILD_EXIT -eq 124 ]; then
  echo "  build timed out after 15m" >&2; FAILED=true
elif [ $BUILD_EXIT -ne 0 ]; then
  echo "  build failed (exit $BUILD_EXIT) — reproduce with: npm run build" >&2; FAILED=true
fi

# 5. Full test suite. Log to a unique file: a fixed /tmp path races between
# concurrent pushes from sibling worktrees and truncates the other's output.
echo "  [5/5] test (full suite)"
TEST_LOG=$(mktemp "${TMPDIR:-/tmp}/caws-pre-push-test.XXXXXX")
run_with_timeout 900 npm test 2>&1 | tee "$TEST_LOG"
TEST_EXIT=${PIPESTATUS[0]}
if [ "$TEST_EXIT" -eq 124 ]; then
  echo "  test suite timed out after 15m" >&2; FAILED=true
elif [ "$TEST_EXIT" -ne 0 ]; then
  echo "  test suite failed (exit $TEST_EXIT); last 100 lines:" >&2
  tail -100 "$TEST_LOG" >&2
  FAILED=true
fi
rm -f "$TEST_LOG"

if [ "$FAILED" = true ]; then
  echo "" >&2
  echo "pre-push: refusing the push — the checks above must pass." >&2
  exit 1
fi

echo "pre-push: all checks passed"
exit 0
