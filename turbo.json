{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", ".caws/**", "!**/*.test.*"],
      "outputs": ["dist/**", "build/**", ".agent/**"]
    },
    "lint": {
      "dependsOn": [],
      "inputs": ["src/**", ".caws/**", "*.js", "*.json"]
    },
    "lint:fix": {
      "dependsOn": [],
      "inputs": ["src/**", ".caws/**", "*.js", "*.json"]
    },
    "format": {
      "dependsOn": [],
      "inputs": ["src/**", ".caws/**", "*.js", "*.json", "*.md"]
    },
    "test": {
      "dependsOn": ["^build", "lint"],
      "inputs": ["src/**", "tests/**", ".caws/**", "scripts/**", "tsconfig*.json", "package.json"],
      "outputs": ["coverage/**"]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "scripts/**", "tsconfig*.json", "package.json"],
      "outputs": []
    },
    "test:watch": {
      "dependsOn": [],
      "persistent": true,
      "cache": false
    },
    "validate": {
      "dependsOn": [],
      "inputs": [".caws/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "*.ts", "*.tsx", "tsconfig*.json"]
    },
    "clean": {
      "dependsOn": [],
      "cache": false
    },
    "dev": {
      "dependsOn": ["build"],
      "persistent": true,
      "cache": false
    }
  },
  "globalDependencies": [
    "package.json",
    "turbo.json",
    "eslint.config.js",
    ".prettierrc",
    "package-lock.json",
    "rust-toolchain.toml",
    "packages/caws-native/Cargo.toml",
    "packages/caws-native/Cargo.lock",
    "packages/caws-native/build.rs",
    "packages/caws-native/src/**",
    "packages/caws-native/tests/**",
    "packages/caws-cli/scripts/**",
    "packages/caws-cli/tsconfig*.json"
  ]
}
