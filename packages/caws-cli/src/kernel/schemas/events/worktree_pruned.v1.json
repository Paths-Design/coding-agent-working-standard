{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caws.paths.design/schemas/events/worktree_pruned.v1.json",
  "title": "worktree_pruned event payload",
  "$comment": "Records ghost-registry removal or revalidated absence of an exact creation. Reconciliation appends a receipt; it neither rewrites history nor asserts task completion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "worktree_name",
    "h_class",
    "reason"
  ],
  "properties": {
    "worktree_name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "description": "Name of the pruned worktree (the stale key removed from worktrees.json)."
    },
    "h_class": {
      "enum": [
        "ghost_registry",
        "verified_dead_creation"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable authority reason, e.g. 'no backing git worktree and canonical dir absent (H1 ghost)'."
    },
    "spec_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*-\\d+[a-z]*$",
      "description": "Optional: the spec id the ghost registry entry claimed, when present. A legitimate ghost may lack one."
    },
    "created_event_seq": {
      "type": "integer",
      "minimum": 1
    },
    "created_event_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "h_class": {
            "const": "verified_dead_creation"
          }
        }
      },
      "then": {
        "required": [
          "created_event_seq",
          "created_event_hash",
          "branch",
          "path"
        ],
        "properties": {
          "created_event_seq": {
            "type": "integer",
            "minimum": 1
          },
          "created_event_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
