        },
        "start_sha": {
          "type": "string"
        },
        "dirty_files": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string"
        },
        "log": {
          "type": "string"
        },
        "diff_stat": {
          "type": "string"
        },
        "diff_excerpt": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "turnIndexEntry": {
