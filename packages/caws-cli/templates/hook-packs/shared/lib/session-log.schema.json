    "turnContext": {
      "type": "object",
      "description": "Session-scoped self-identification embedded in every turn so the file can be interpreted off-machine with no sibling files. branch/head_sha/dirty_files are the repo state at the MOST RECENT render of the session (session-log.sh reads them live), not per-turn history; start_sha is the session-start anchor carried from .meta.json. Deliberately no render timestamp: a volatile field would defeat the renderer's byte-identical write skip.",
      "required": [
        "session_id",
        "project",
        "cwd"
      ],
      "properties": {
        "session_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "project": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "session_started_at": {
          "$ref": "#/$defs/timestampLike"
        },
        "branch": {
          "type": "string"
        },
        "head_sha": {
          "type": "string"
        },
        "start_sha": {
          "type": "string"
        },
        "dirty_files": {
          "type": "integer",
          "minimum": 0
        },
        "lineage": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "parent_session_id",
                "source",
                "authority",
                "source_path"
              ],
              "properties": {
                "parent_session_id": {
                  "type": "string"
                },
                "source": {
                  "const": "transcript_metadata"
                },
                "authority": {
                  "const": "none"
                },
                "source_path": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "interjection": {
      "type": "object",
      "description": "A user message sent mid-turn (queued_command attachment with origin.kind=human). Text is normalized: the legacy <user>...</user> wrapper is stripped. Each interjection ALSO appears inline in the timeline as a kind=interjection item at its arrival position; this array is the index.",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "ts": {
          "$ref": "#/$defs/timestampLike"
        }
      },
      "additionalProperties": true
    }
  }
