{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sterling.local/schemas/caws/session-log.schema.json",
  "title": "CAWS Session Log Artifact",
  "description": "CAWS-MANAGED-HOOK hook_pack=shared hook_pack_version=1 caws_min_major=11 edit_stance: YOURS TO EDIT. This is a starting schema, not a locked one — extend it as your session-log contract grows. JSON carries the managed marker in this description field because JSON has no comment syntax; the marker is only how caws init finds the file it can offer updates for, not a keep-out sign. JSON artifacts stored under .caws/sessions/<session-id>/ by .caws/hooks/session-log.sh and its renderer.",
  "oneOf": [
    {
      "$ref": "#/$defs/turnArtifact"
    },
    {
      "$ref": "#/$defs/sessionMetadataArtifact"
    },
    {
      "$ref": "#/$defs/sessionPointerArtifact"
    },
    {
      "$ref": "#/$defs/sessionIndexArtifact"
    },
    {
      "$ref": "#/$defs/legacySessionIndexArtifact"
    },
    {
      "$ref": "#/$defs/legacyHandoffArtifact"
    }
  ],
  "$defs": {
    "stringOrNull": {
      "type": [
        "string",
        "null"
      ],
      "properties": {}
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "properties": {}
    },
    "timestampLike": {
      "type": [
        "string",
        "null"
      ],
      "description": "UTC ISO-8601 or hook-provided local timestamp string.",
      "properties": {}
    },
    "pathString": {
      "type": "string",
      "minLength": 1,
      "properties": {}
    },
    "fileRefs": {
      "type": "object",
      "required": [
        "edited",
        "read"
      ],
      "properties": {
        "edited": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pathString"
          }
        },
        "read": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pathString"
          }
        }
      },
      "additionalProperties": true
    },
    "commandRef": {
      "type": "object",
      "required": [
        "command"
      ],
      "properties": {
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "command": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "description": "Human description attached to the command by the emitting agent."
        },
        "output_preview": {
          "type": [
            "string",
            "null"
          ]
        },
        "output": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_error": {
          "type": "boolean"
        },
        "duration_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "ts": {
          "$ref": "#/$defs/timestampLike"
        },
        "provenance": {
          "type": [
            "string",
            "null"
          ]
        },
        "execution": {
          "enum": [
            "not_observed"
          ]
        }
      },
      "additionalProperties": true
    },
    "searchRef": {
      "type": "object",
      "properties": {
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "pattern": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "ts": {
          "$ref": "#/$defs/timestampLike"
        },
        "execution": {
          "enum": [
            "not_observed"
          ]
        }
      },
      "additionalProperties": true
    },
    "agentRef": {
      "type": "object",
      "properties": {
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "subagent_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_preview": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "ts": {
          "$ref": "#/$defs/timestampLike"
        },
        "output": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_preview": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "subagent": {
          "type": "object",
          "description": "Fork linkage joined from agent-*.meta.json beside the parent transcript: where the fork's own transcript lives and what it was. Present only for harnesses that record fork metadata (claude-code).",
          "properties": {
            "transcript": {
              "type": "string",
              "description": "Fork transcript filename within the session's subagents directory."
            },
            "agent_type": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "spawn_depth": {
              "type": "integer",
              "minimum": 1
            },
            "description": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "decisionRef": {
      "type": "object",
      "description": "A heuristic-extracted decision, emitted by extract_heuristic_fields as {statement, source}.",
      "required": [
        "statement"
      ],
      "properties": {
        "statement": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "artifactRef": {
      "type": "object",
      "description": "The renderer emits three artifact shapes, all keyed by type: file_edit/file_write carry `path`; git_commit/test_run carry `command`; plan carries `content` (+ content_truncated when the plan text exceeded the artifact bound). Only `type` is universal.",
      "required": [
        "type"
      ],
      "properties": {
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "content_truncated": {
          "type": "boolean",
          "description": "plan artifacts: the content was bounded to the artifact limit."
        },
        "ts": {
          "$ref": "#/$defs/timestampLike"
        },
        "execution": {
          "enum": [
            "not_observed"
          ]
        }
      },
      "additionalProperties": true
    },
    "refs": {
      "type": "object",
      "required": [
        "files",
        "searches",
        "commands",
        "agents",
        "artifacts"
      ],
      "properties": {
        "files": {
          "$ref": "#/$defs/fileRefs"
        },
        "searches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/searchRef"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commandRef"
          }
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agentRef"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        }
      },
      "additionalProperties": true
    },
    "timelineItem": {
      "type": "object",
      "description": "One ordered event of the turn. Variants are discriminated by `kind`: reasoning carries `text` (assistant prose, provenance=assistant_reasoning; model deliberation, provenance=thinking — claude thinking blocks, codex plaintext reasoning summaries, qwen thought-flagged parts — with thought=true and optional text_truncated/text_length/text_ref bounding); tool_call carries the tool-specific fields below (Bash: command/description/run_in_background; Edit: file/old_string/new_string with *_length + *_truncated; Write: file/content_preview/content_length; Agent: prompt/subagent_type/isolation; Skill: skill/args; ExitPlanMode: plan; codex exec: input_raw/input_length/input_truncated/inner_actions); interjection carries `text` (mid-turn user steering, inline at arrival position); user_shell carries a !-command the USER ran (command/stdout/stderr, entity-unescaped, input+output rows merged into one item; a trailing `! git push` is recorded on the turn whose work it shipped); control carries harness governance/steering events (subtype + text: codex turn_aborted, dsh session_title/approval_policy/permission_preset/sandbox_mode/subagent_descriptor/agent_inbox_spliced) inline at the position they occurred; audit_action and context_authority are hook-derived. Truncation contract: any clipped field X carries X_truncated=true and X_length = the ORIGINAL length; substantive payloads at or under the full-retention ceiling (20000 chars) are emitted WHOLE with only the flag set — a flag means bounded, output_cut=true means bytes were actually cut, and a cut field X carries X_ref = {sha256, length} addressing the full bytes in turn-NNN.payloads.json; Bash/Agent/Task outputs follow the same contract.",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "reasoning",
            "tool_call",
            "tool_output",
            "interjection",
            "user_shell",
            "audit_action",
            "context_authority",
            "control"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "text_truncated": {
          "type": "boolean",
          "description": "reasoning items: the thinking text was bounded per the truncation contract."
        },
        "text_length": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "reasoning items: ORIGINAL thinking text length before bounding."
        },
        "text_ref": {
          "$ref": "#/$defs/payloadRef",
          "description": "reasoning items: content address of the full thinking text in the payloads sidecar."
        },
        "thought": {
          "type": "boolean",
          "description": "reasoning items: true when the text is model deliberation (claude thinking block, codex reasoning summary, qwen thought-flagged part) rather than assistant prose."
        },
        "subtype": {
          "type": [
            "string",
            "null"
          ],
          "description": "control items: the harness governance event class (session_title, approval_policy, permission_preset, sandbox_mode, subagent_descriptor, agent_inbox_spliced, turn_aborted)."
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "description": "control items: where the governance value came from (e.g. dsh 'delegation')."
        },
        "duration_ms": {
          "type": [
            "number",
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "control items: wall duration for events that carry one (e.g. codex turn_aborted)."
        },
        "permission_mode": {
          "type": [
            "string",
            "null"
          ],
          "description": "audit_action items: the permission mode the hook observed."
        },
        "ts": {
          "$ref": "#/$defs/timestampLike"
        },
        "result_ts": {
          "$ref": "#/$defs/timestampLike"
        },
        "provenance": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_use_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_error": {
          "type": "boolean"
        },
        "duration_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Tool name on tool_call items."
        },
        "id": {
          "type": [
            "string",
            "null"
          ],
          "description": "tool_use id pairing a call with its result."
        },
        "command": {
          "type": [
            "string",
            "null"
          ],
          "description": "Bash tool_call or user_shell command, carried in full."
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_in_background": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "output": {
          "type": [
            "string",
            "null",
            "array",
            "object"
          ],
          "description": "Tool result. Complete for Bash/Agent/Task; other tools clip per the truncation contract. Usually a string, but tools whose results are structured content blocks (tool_reference lists from EnterWorktree/TaskCreate/SendMessage/MCP tools, etc.) pass through as the raw array/object — code over this field must handle both."
        },
        "output_length": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "ORIGINAL result length before any clipping."
        },
        "output_truncated": {
          "type": "boolean"
        },
        "output_cut": {
          "type": "boolean",
          "description": "True only when output bytes were actually CUT (the full payload lives in the turn's payloads sidecar). A whole-inlined over-limit payload is output_truncated=true but output_cut=false."
        },
        "output_ref": {
          "$ref": "#/$defs/payloadRef",
          "description": "Content address of the full output in turn-NNN.payloads.json, present only when the output was cut."
        },
        "file": {
          "type": [
            "string",
            "null"
          ],
          "description": "cwd-relative path on Edit/Write/Read tool_calls."
        },
        "old_string": {
          "type": [
            "string",
            "null"
          ]
        },
        "old_string_length": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "old_string_truncated": {
          "type": "boolean"
        },
        "old_string_ref": {
          "$ref": "#/$defs/payloadRef"
        },
        "new_string": {
          "type": [
            "string",
            "null"
          ]
        },
        "new_string_length": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "new_string_truncated": {
          "type": "boolean"
        },
        "new_string_ref": {
          "$ref": "#/$defs/payloadRef"
        },
        "content_preview": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_length": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "content_truncated": {
          "type": "boolean"
        },
        "content_ref": {
          "$ref": "#/$defs/payloadRef"
        },
        "source_harness": {
          "type": [
            "string",
            "null"
          ],
          "description": "Harness the tool_call row originated from (claude-code / codex / ...)."
        },
        "prompt_length": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "ORIGINAL Agent dispatch prompt length before any bounding."
        },
        "prompt_truncated": {
          "type": "boolean"
        },
        "prompt_ref": {
          "$ref": "#/$defs/payloadRef"
        },
        "plan_length": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "plan_truncated": {
          "type": "boolean"
        },
        "plan_ref": {
          "$ref": "#/$defs/payloadRef"
        },
        "input_preview": {
          "type": [
            "string",
            "null"
          ],
          "description": "audit_action: bounded JSON of the tool input."
        },
        "input_ref": {
          "$ref": "#/$defs/payloadRef"
        },
        "response": {
          "type": [
            "string",
            "null"
          ],
          "description": "audit_action: bounded JSON of the tool response."
        },
        "response_truncated": {
          "type": "boolean"
        },
        "response_ref": {
          "$ref": "#/$defs/payloadRef"
        },
        "prompt": {
          "type": [
            "string",
            "null"
          ],
          "description": "Agent dispatch prompt (bounded and flagged per the truncation contract; whole text inlined at or under the full-retention ceiling)."
        },
        "subagent_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "isolation": {
          "type": [
            "string",
            "null"
          ]
        },
        "skill": {
          "type": [
            "string",
            "null"
          ]
        },
        "args": {
          "type": [
            "string",
            "null"
          ]
        },
        "plan": {
          "type": [
            "string",
            "null"
          ]
        },
        "query": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_length": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "input_truncated": {
          "type": "boolean"
        },
        "inner_actions": {
          "type": "array"
        },
        "stdout": {
          "type": [
            "string",
            "null"
          ],
          "description": "user_shell output, html-entity-unescaped."
        },
        "stderr": {
          "type": [
            "string",
            "null"
          ]
        },
        "hook_contexts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hookContext"
          },
          "description": "Hook contexts attached to this specific tool call (in addition to the turn-level hook_contexts array)."
        }
      },
      "additionalProperties": true
    },
    "payloadRef": {
      "type": "object",
      "description": "Content address of a full payload stored in the turn's payloads sidecar (turn-NNN.payloads.json), keyed by sha256 of the UTF-8 bytes.",
      "required": [
        "sha256",
        "length"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "length": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "contextAuthority": {
      "type": "object",
      "properties": {
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "attachment": {
          "type": [
            "string",
            "null"
          ]
        },
        "sections": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": true
    },
    "hookContext": {
      "type": "object",
      "properties": {
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "hook_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "hook_event": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_use_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "additional_context": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_authority": {
          "anyOf": [
            {
              "$ref": "#/$defs/contextAuthority"
            },
            {
              "type": "null"
            }
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ],
          "description": "Handler status as recorded by the hook-outcome sidecar (completed / blocked / ...)."
        },
        "tool_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Tool the hook event adjudicated, when the sidecar recorded one."
        },
        "stdout": {
          "type": [
            "string",
            "null"
          ],
          "description": "Raw handler stdout from the hook-outcome sidecar."
        },
        "stderr": {
          "type": [
            "string",
            "null"
          ],
          "description": "Raw handler stderr from the hook-outcome sidecar."
        },
        "provenance": {
          "type": [
            "string",
            "null"
          ],
          "description": "Where the hook context came from (hook_outcome_sidecar, codex_developer_message, ...)."
        },
        "duration_ms": {
          "type": [
            "number",
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ts": {
          "$ref": "#/$defs/timestampLike"
        },
        "observation_boundary": {
          "type": [
            "string",
            "null"
          ]
        },
        "delivery": {
          "type": [
            "string",
            "null"
          ]
        },
        "invocation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "adapter_exit_code": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "turnArtifact": {
      "type": "object",
      "required": [
        "schema_version",
        "turn",
        "status",
        "refs",
        "timeline"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 2
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "payloads_sidecar": {
          "type": [
            "string",
            "null"
          ],
          "description": "Sibling sidecar file holding full bytes of payloads over the retention ceiling; null when the turn spilled nothing."
        },
        "payloads_sha256": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "description": "Content addresses carried by payloads_sidecar."
        },
        "ts_start": {
          "$ref": "#/$defs/timestampLike"
        },
        "ts_end": {
          "$ref": "#/$defs/timestampLike"
        },
        "user": {
          "$ref": "#/$defs/stringOrNull"
        },
        "user_ts": {
          "$ref": "#/$defs/timestampLike"
        },
        "turn_summary": {
          "$ref": "#/$defs/stringOrNull"
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "blocked",
            "error",
            "rewound"
          ],
          "description": "rewound outranks the outcome statuses: the user rewound past this turn, so whatever it produced (including an error) was discarded."
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decisionRef"
          }
        },
        "next_action": {
          "$ref": "#/$defs/stringOrNull"
        },
        "blocking_issue": {
          "$ref": "#/$defs/stringOrNull"
        },
        "refs": {
          "$ref": "#/$defs/refs"
        },
        "hook_contexts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hookContext"
          }
        },
        "timeline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timelineItem"
          }
        },
        "context": {
          "anyOf": [
            {
              "$ref": "#/$defs/turnContext"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absent on artifacts rendered before 2026-08-19."
        },
        "ended_by": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "user_interrupt_tool",
                "user_interrupt_generation",
                "user_interrupt"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "How the turn ended when it did not end normally — the user pressed escape mid-action ('[Request interrupted' event), the strongest steering signal a session records. user_interrupt_tool = the user vetoed a specific action the agent proposed ('for tool use'); user_interrupt_generation = the user cut the reply off. null/absent = the agent finished on its own. user_interrupt is the legacy collapsed value: still accepted so artifacts written before the split keep validating, never emitted now."
        },
        "interjections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interjection"
          }
        },
        "usage": {
          "type": "object",
          "description": "Token usage summed over the turn's assistant steps (claude per-message usage; codex token_usage_record). Present only when the harness supplied usage data.",
          "properties": {
            "input_tokens": {
              "type": "number",
              "minimum": 0
            },
            "output_tokens": {
              "type": "number",
              "minimum": 0
            },
            "cache_read_input_tokens": {
              "type": "number",
              "minimum": 0
            },
            "cache_creation_input_tokens": {
              "type": "number",
              "minimum": 0
            },
            "cached_input_tokens": {
              "type": "number",
              "minimum": 0
            },
            "reasoning_output_tokens": {
              "type": "number",
              "minimum": 0
            },
            "total_tokens": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": true
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Distinct models that produced the turn's assistant steps, in first-use order. Present only when the harness recorded per-message models."
        },
        "stop_reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "How the turn's FINAL assistant step ended (tool_use / end_turn / max_tokens / ...). Present only when the harness recorded stop reasons."
        },
        "env": {
          "type": "object",
          "description": "Environment anchors carried on the turn boundary (codex turn_context): model, effort, cwd, approval_policy, sandbox_policy.",
          "additionalProperties": true
        },
        "rewound_from": {
          "type": "integer",
          "minimum": 1,
          "description": "The turn number this turn replaced: the user rewound past that turn and re-sent on the same conversational slot. Absent when the turn is not a rewind."
        },
        "rewind_kind": {
          "type": "string",
          "enum": [
            "same_prompt",
            "edited_prompt"
          ],
          "description": "Whether the re-sent prompt was byte-identical to the one it replaced or edited. Present exactly when rewound_from is."
        }
      },
      "additionalProperties": true
    },
    "sessionMetadataArtifact": {
      "type": "object",
      "required": [
        "session_id",
        "started_at",
        "local_time",
        "model",
        "source",
        "branch",
        "head_sha",
        "dirty_files",
        "project",
        "transcript_path"
      ],
      "properties": {
        "session_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "started_at": {
          "$ref": "#/$defs/timestampLike"
        },
        "local_time": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "model": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "branch": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "head_sha": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "dirty_files": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          ]
        },
        "project": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "transcript_path": {
          "type": "string"
        },
        "ended": {
          "type": "object",
          "description": "Written by the SessionEnd handler when the session terminates. Absent on a session still running, or one whose harness fires no SessionEnd.",
          "required": [
            "reason",
            "ts"
          ],
          "properties": {
            "reason": {
              "$ref": "#/$defs/nonEmptyString",
              "description": "The harness's own reason string (claude-code: clear | logout | prompt_input_exit | other), recorded verbatim rather than mapped, so a new harness value is preserved instead of collapsed."
            },
            "ts": {
              "$ref": "#/$defs/timestampLike"
            }
          },
          "additionalProperties": false
        },
        "usage": {
          "type": "object",
          "description": "Token usage summed over all turns.",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "additionalProperties": true
    },
    "sessionPointerArtifact": {
      "type": "object",
      "required": [
        "session_id",
        "repo_root",
        "last_seen_at"
      ],
      "properties": {
        "session_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "repo_root": {
          "$ref": "#/$defs/pathString"
        },
        "created_at": {
          "$ref": "#/$defs/timestampLike"
        },
        "last_seen_at": {
          "$ref": "#/$defs/timestampLike"
        },
        "hook_event": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "sessionIndexArtifact": {
      "type": "object",
      "description": "Orientation index written beside a session's turn files (session-index.json): the entry point for reorienting on a session's history or reviewing it remotely without local access. Title, models, and usage appear only when the session's harness supplied them; model is recovered from the transcript when the SessionStart metadata said 'unknown'.",
      "required": [
        "schema_version",
        "session_id",
        "turn_count"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "session_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "project": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "description": "Session title (claude ai-title / dsh session/title); the last one observed."
        },
        "model": {
          "type": "string",
          "description": "First model the session's assistant steps actually used."
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Distinct models used across the session, first-use order."
        },
        "turn_count": {
          "type": "integer",
          "minimum": 1
        },
        "ts_start": {
          "$ref": "#/$defs/timestampLike"
        },
        "ts_end": {
          "$ref": "#/$defs/timestampLike"
        },
        "branch": {
          "type": "string"
        },
        "head_sha": {
          "type": "string"
        },
        "usage": {
          "type": "object",
          "description": "Token usage summed over all turns.",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "additionalProperties": true
    },
    "gitSnapshot": {
      "type": "object",
      "required": [
        "branch",
        "head_sha",
        "start_sha",
