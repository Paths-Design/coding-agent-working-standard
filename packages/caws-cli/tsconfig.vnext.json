// caws-cli vNext build/typecheck config.
//
// CAWS-ABSORB-KERNEL-01: the kernel (formerly packages/caws-kernel) is now
// absorbed into this package at src/kernel/. This config compiles the whole
// src/ tree (store + shell + kernel) into dist/ in one tsc pass — no separate
// kernel build, no workspace dependency, no cross-package resolution. The
// former "validates the published surface via the workspace symlink" rationale
// is moot: the kernel has no external consumer and is not published.
//
// Strictness: carries the kernel's full correctness flag set
// (noImplicitReturns, noFallthroughCasesInSwitch, isolatedModules,
// resolveJsonModule — the JSON schemas at src/kernel/schemas/*.json are
// imported by validate-shape.ts and emitted to dist/ via resolveJsonModule)
// for the whole src tree. The CLI's existing store/shell code benefits from
// the same flags.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src/store/**/*.ts", "src/shell/**/*.ts", "src/kernel/**/*.ts"]
}
