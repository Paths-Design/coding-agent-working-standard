  },
  {
    "label": "uncertain: slash in id",
    "object": true,
    "expected": "uncertain",
    "json": "{\"session_id\":\"custody-session\",\"agent_id\":\"sub/1\"}"
  },
  {
    "label": "uncertain: newline in id",
    "object": true,
    "expected": "uncertain",
    "json": "{\"session_id\":\"custody-session\",\"agent_id\":\"sub\\n1\"}"
