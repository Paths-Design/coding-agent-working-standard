  {
    "label": "uncertain: duplicate key, last value empty",
    "object": true,
    "expected": "uncertain",
    "json": "{\"session_id\":\"custody-session\",\"agent_id\":\"sub-1\",\"agent_id\":\"\"}"
  },
  {
    "label": "uncertain: raw control byte between members (a lenient parser repairs it)",
    "object": true,
    "expected": "uncertain",
    "json": "{\"session_id\":\"custody-session\",\u0001\"tool_name\":\"Read\"}"
  },
  {
    "label": "uncertain: raw NUL inside the agent_id key (a lenient parser keeps a different key)",
